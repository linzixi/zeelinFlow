# 复制到根目录 .env。已有本机配置请保留，不要覆盖用户凭据。
# 下方为字段模板，密码/令牌仅填写在 .env。
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/drama2seed?charset=utf8mb4
DB_ECHO=false
DB_AUTO_CREATE=true
REDIS_CONN_STRING=redis://:PASSWORD@127.0.0.1:6379/0
REDIS_KEY_PREFIX=qingbo
CACHE_ENABLED=true

# 原生 DeerFlow 模型（OpenAI compatible）
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ACE 扩展运行时
ACE_DF_TENANT=local
ACE_DF_DATA_WORKERS=4
ACE_DF_AGENT_WORKERS=2
ACE_DF_LEASE_SECONDS=90
ACE_DF_POLL_SECONDS=1
ACE_DF_AGENT_TIMEOUT_SECONDS=1800
ACE_DF_GATEWAY_URL=http://127.0.0.1:8001
# 原生用户 ID + 该用户签发的 PAT，供重启后的定时任务使用
ACE_DF_AGENT_OWNER_ID=
ACE_DF_AGENT_API_TOKEN=
ACE_DF_OUTPUT_ROOT=.ace-data

# 可选：现有 ES 网关，或统一数据桥接服务（优先使用后者）
GSDATAS_ES_TOKEN=
GSDATAS_ES_GATEWAY_URL=http://gateway.gsdatas.cn/mg/search/es
ACE_DF_SOURCE_URL=
ACE_DF_SOURCE_TOKEN=

# 上汽通用完整分页数据源（签名只在服务端计算）
SQTY_APP_ID=
SQTY_APP_SECRET=
SQTY_API_URL=https://aipincustom.gsdata.cn/customapi/shangQi/index/query

# 视频下载与转写：状态持久化在 ace_df_external_jobs，轮询释放 worker
SGM_SIS_ENABLED=false
SGM_SIS_DB_HOST=
SGM_SIS_DB_PORT=3306
SGM_SIS_DB_NAME=download_news
SGM_SIS_DB_USER=
SGM_SIS_DB_PASSWORD=
SGM_SIS_PROJECT_ID=ADMIN-2021-0004
SGM_SIS_POLL_SECONDS=15
SGM_SIS_TIMEOUT_MINUTES=60
SGM_ASR_URL=
SGM_ASR_ACCESS_KEY=
SGM_ASR_SECRET_KEY=
SGM_ETL_HOST=http://etl.gsdatas.cn:19615
SGM_ETL_TOKEN=
SGM_ETL_SECRET=
SGM_ETL_TIMEOUT=10
SGM_ETL_RETRIES=3
